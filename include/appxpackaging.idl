[
    object,
    pointer_default(ref),
    uuid(b5c49650-99bc-481c-9a34-3d53a4106708)
]
interface IAppxPackageReader : IUnknown
{
    HRESULT GetBlockMap([out, retval] IAppxBlockMapReader **value);
    HRESULT GetFootprintFile([in] APPX_FOOTPRINT_FILE_TYPE type, [out, retval] IAppxFile **value);
    HRESULT GetPayloadFile([in, string] const WCHAR *file_name, [out, retval] IAppxFile **value);
    HRESULT GetPayloadFiles([out, retval] IAppxFilesEnumerator **value);
    HRESULT GetManifest([out, retval] IAppxManifestReader **value);
}

[
    object,
    pointer_default(ref),
    uuid(9099e33b-246f-41e4-881a-008eb613f858)
]
interface IAppxPackageWriter : IUnknown
{
    HRESULT AddPayloadFile([in, string] const WCHAR *file_name, [in, string] const WCHAR *content_type, [in] APPX_COMPRESSION_OPTION compression_option, [in] IStream *input_stream);
    HRESULT Close([in] IStream *manifest);
}

