[
    object,
    pointer_default(ref),
    uuid(283ce2d7-7153-4a91-9649-7a0f7240945f)
]
interface IAppxManifestPackageId : IUnknown
{
    HRESULT GetName([out, retval, string] WCHAR **value);
    HRESULT GetArchitecture([out, retval] APPX_PACKAGE_ARCHITECTURE *value);
    HRESULT GetPublisher([out, retval, string] WCHAR **value);
    HRESULT GetVersion([out, retval] UINT64 *value);
    HRESULT GetResourceId([out, retval, string] WCHAR **value);
    HRESULT ComparePublisher([in, string] const WCHAR *other, [out, retval] BOOL *value);
    HRESULT GetPackageFullName([out, retval, string] WCHAR **value);
    HRESULT GetPackageFamilyName([out, retval, string] WCHAR **value);
}

[
    object,
    pointer_default(ref),
    uuid(03faf64d-f26f-4b2c-aaf7-8fe7789b8bca)
