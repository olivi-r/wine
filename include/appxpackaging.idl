}

[
    object,
    pointer_default(ref),
    uuid(4e1bd148-55a0-4480-a3d1-15544710637c)
]
interface IAppxManifestReader : IUnknown
{
    HRESULT GetPackageId([out, retval] IAppxManifestPackageId **value);
    HRESULT GetProperties([out, retval] IAppxManifestProperties **value);
    HRESULT GetPackageDependencies([out, retval] IAppxManifestPackageDependenciesEnumerator **value);
    HRESULT GetCapabilities([out, retval] APPX_CAPABILITIES *value);
    HRESULT GetResources([out, retval] IAppxManifestResourcesEnumerator **value);
    HRESULT GetDeviceCapabilities([out, retval] IAppxManifestDeviceCapabilitiesEnumerator **value);
    HRESULT GetPrerequisite([in, string] const WCHAR *name, [out, retval] UINT64 *value);
    HRESULT GetApplications([out, retval] IAppxManifestApplicationsEnumerator **value);
    HRESULT GetStream([out, retval] IStream **value);
}

[
    object,
    pointer_default(ref),
    uuid(de4dfbbd-881a-48bb-858c-d6f2baeae6ed)
]
