import "objidl.idl";
import "unknwn.idl";
import "urlmon.idl";

typedef enum APPX_CAPABILITIES APPX_CAPABILITIES;
typedef enum APPX_COMPRESSION_OPTION APPX_COMPRESSION_OPTION;
typedef enum APPX_FOOTPRINT_FILE_TYPE APPX_FOOTPRINT_FILE_TYPE;
typedef enum APPX_PACKAGE_ARCHITECTURE APPX_PACKAGE_ARCHITECTURE;

typedef struct APPX_PACKAGE_SETTINGS APPX_PACKAGE_SETTINGS;

interface IAppxBlockMapBlock;
interface IAppxBlockMapBlocksEnumerator;
interface IAppxBlockMapFile;
interface IAppxBlockMapFilesEnumerator;
interface IAppxBlockMapReader;
interface IAppxFactory;
interface IAppxFactory2;
interface IAppxFactory3;
interface IAppxFactory4;
interface IAppxFile;
interface IAppxFilesEnumerator;
interface IAppxManifestApplication;
interface IAppxManifestApplicationsEnumerator;
interface IAppxManifestDeviceCapabilitiesEnumerator;
interface IAppxManifestPackageDependenciesEnumerator;
interface IAppxManifestPackageDependency;
interface IAppxManifestPackageId;
interface IAppxManifestProperties;
interface IAppxManifestReader;
interface IAppxManifestResourcesEnumerator;
interface IAppxPackageReader;
interface IAppxPackageWriter;

coclass AppxFactory;

enum APPX_CAPABILITIES
{
    APPX_CAPABILITY_INTERNET_CLIENT               = 0x001,
    APPX_CAPABILITY_INTERNET_CLIENT_SERVER        = 0x002,
    APPX_CAPABILITY_PRIVATE_NETWORK_CLIENT_SERVER = 0x004,
    APPX_CAPABILITY_DOCUMENTS_LIBRARY             = 0x008,
    APPX_CAPABILITY_PICTURES_LIBRARY              = 0x010,
    APPX_CAPABILITY_VIDEOS_LIBRARY                = 0x020,
    APPX_CAPABILITY_MUSIC_LIBRARY                 = 0x040,
    APPX_CAPABILITY_ENTERPRISE_AUTHENTICATION     = 0x080,
    APPX_CAPABILITY_SHARED_USER_CERTIFICATES      = 0x100,
    APPX_CAPABILITY_REMOVABLE_STORAGE             = 0x200,
    APPX_CAPABILITY_APPOINTMENTS                  = 0x400,
    APPX_CAPABILITY_CONTACTS                      = 0x800,
};

enum APPX_COMPRESSION_OPTION
{
    APPX_COMPRESSION_OPTION_NONE      = 0,
    APPX_COMPRESSION_OPTION_NORMAL    = 1,
    APPX_COMPRESSION_OPTION_MAXIMUM   = 2,
    APPX_COMPRESSION_OPTION_FAST      = 3,
    APPX_COMPRESSION_OPTION_SUPERFAST = 4,
};

enum APPX_FOOTPRINT_FILE_TYPE
{
    APPX_FOOTPRINT_FILE_TYPE_MANIFEST        = 0,
    APPX_FOOTPRINT_FILE_TYPE_BLOCKMAP        = 1,
    APPX_FOOTPRINT_FILE_TYPE_SIGNATURE       = 2,
    APPX_FOOTPRINT_FILE_TYPE_CODEINTEGRITY   = 3,
    APPX_FOOTPRINT_FILE_TYPE_CONTENTGROUPMAP = 4,
};

enum APPX_PACKAGE_ARCHITECTURE
{
    APPX_PACKAGE_ARCHITECTURE_X86     = 0,
    APPX_PACKAGE_ARCHITECTURE_ARM     = 5,
    APPX_PACKAGE_ARCHITECTURE_X64     = 9,
    APPX_PACKAGE_ARCHITECTURE_NEUTRAL = 11,
    APPX_PACKAGE_ARCHITECTURE_ARM64   = 12,
};

struct APPX_PACKAGE_SETTINGS
{
    BOOL  forceZip32;
    IUri *hashMethod;
};

[
    object,
    pointer_default(unique),
    uuid(75cf3930-3244-4fe0-a8c8-e0bcb270b889)
]
interface IAppxBlockMapBlock : IUnknown
{
    HRESULT GetHash([out] UINT32 *size, [out, retval, size_is(, *size)] BYTE **value);
    HRESULT GetCompressedSize([out, retval] UINT32 *value);
}

[
    object,
    pointer_default(ref),
    uuid(6b429b5b-36ef-479e-b9eb-0c1482b49e16)
]
interface IAppxBlockMapBlocksEnumerator : IUnknown
{
    HRESULT GetCurrent([out, retval] IAppxBlockMapBlock **value);
    HRESULT GetHasCurrent([out, retval] BOOL *value);
    HRESULT MoveNext([out, retval] BOOL *value);
}

[
    object,
    pointer_default(ref),
    uuid(277672ac-4f63-42c1-8abc-beae3600eb59)
]
interface IAppxBlockMapFile : IUnknown
{
    HRESULT GetBlocks([out, retval] IAppxBlockMapBlocksEnumerator **value);
    HRESULT GetLocalFileHeaderSize([out, retval] UINT32 **value);
    HRESULT GetName([out, retval, string] WCHAR **value);
    HRESULT GetUncompressedSize([out, retval] UINT64 **value);
    HRESULT ValidateFileHash([in] IStream *file_stream, [out, retval] BOOL *value);
}

[
    object,
    pointer_default(ref),
    uuid(02b856a2-4262-4070-bacb-1a8cbbc42305)
]
interface IAppxBlockMapFilesEnumerator : IUnknown
{
    HRESULT GetCurrent([out, retval] IAppxBlockMapFile **value);
    HRESULT GetHasCurrent([out, retval] BOOL *value);
    HRESULT MoveNext([out, retval] BOOL *value);
}

[
    object,
    pointer_default(ref),
    uuid(5efec991-bca3-42d1-9ec2-e92d609ec22a)
]
interface IAppxBlockMapReader : IUnknown
{
    HRESULT GetFile([in, string] const WCHAR *file_name, [out, retval] IAppxBlockMapFile **value);
    HRESULT GetFiles([out, retval] IAppxBlockMapFilesEnumerator **value);
    HRESULT GetHashMethod([out, retval] IUri **value);
    HRESULT GetStream([out, retval] IStream **value);
}

[
    object,
    pointer_default(ref),
    uuid(beb94909-e451-438b-b5a7-d79e767b75d8)
]
interface IAppxFactory : IUnknown
{
    HRESULT CreatePackageWriter([in] IStream *output_stream, [in] APPX_PACKAGE_SETTINGS *settings, [out, retval] IAppxPackageWriter **value);
    HRESULT CreatePackageReader([in] IStream *input_stream, [out, retval] IAppxPackageReader **value);
    HRESULT CreateManifestReader([in] IStream *input_stream, [out, retval] IAppxManifestReader **value);
    HRESULT CreateBlockMapReader([in] IStream *input_stream, [out, retval] IAppxBlockMapReader **value);
    HRESULT CreateValidatedBlockMapReader([in] IStream *input_stream, [in, string] const WCHAR *signature_file_name, [out, retval] IAppxBlockMapReader **value);
}

[
    object,
    pointer_default(ref),
    uuid(91df827b-94fd-468f-827b-57f41b2f6f2e)
]
interface IAppxFile : IUnknown
{
    HRESULT GetCompressionOption([out, retval] APPX_COMPRESSION_OPTION *value);
    HRESULT GetContentType([out, retval, string] WCHAR **value);
    HRESULT GetName([out, retval, string] WCHAR **value);
    HRESULT GetSize([out, retval] UINT64 *value);
    HRESULT GetStream([out, retval] IStream **value);
}

