    [
        contract(Windows.Foundation.UniversalApiContract, 1.0),
        flags
    ]
    enum ManipulationModes
    {
        None             = 0x00000,
        TranslateX       = 0x00001,
        TranslateY       = 0x00002,
        TranslateRailsX  = 0x00004,
        TranslateRailsY  = 0x00008,
        Rotate           = 0x00010,
        Scale            = 0x00020,
        TranslateInertia = 0x00040,
        RotateInertia    = 0x00080,
        ScaleInertia     = 0x00100,
        All              = 0x0ffff,
        System           = 0x10000,
    };

